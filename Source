        if targetEnum then
            local ok, part = pcall(function() return hum:GetBodyPartR15(targetEnum) end)
            if ok and part then return part end
        end
    end
    local allParts = getBodyParts(char)
    if #allParts == 0 then return char:FindFirstChild("HumanoidRootPart") end
    local crosshair = Camera.ViewportSize * 0.5
    local best, bestDist = nil, math.huge
    for _, part in ipairs(allParts) do
        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if on then
            local dx, dy = sp.X - crosshair.X, sp.Y - crosshair.Y
            local dist = dx * dx + dy * dy
            if dist < bestDist then bestDist = dist; best = part end
        end
    end
    if not best then best = allParts[1] end
    if getFlag("AimbotWallCheck", false) and not isVisible(best.Position, char) then
        local vis = findVisiblePart(char, allParts)
        if vis then return vis end
    end
    return best
end

