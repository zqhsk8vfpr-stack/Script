local function animateMasterVisibility(tags, on)
    tags.NameGui.Enabled = true
    tags.DistGui.Enabled = true
    tags.BoxFrame.Visible = true
    local t = on and 0 or 1
    tween(tags.NameLabel, TWEEN_INFO_FAST, { TextTransparency = t })
    tween(tags.DistLabel, TWEEN_INFO_FAST, { TextTransparency = t })
    tween(tags.BoxStroke, TWEEN_INFO_FAST, { Transparency = t })
end

