-- gamepad helpers
local function isGamepadButtonEnum(key)
    if typeof(key) ~= "EnumItem" then return false end
    local name = key.Name or ""
    return name:find("^Button") ~= nil
end

local function isGamepadButtonDown(buttonEnum)
    local pads = UserInputService:GetConnectedGamepads()
    for _, pad in ipairs(pads) do
        local ok, state = pcall(function() return pad:GetButtonState(buttonEnum) end)
        if ok and state == Enum.UserInputState.Begin then
            return true
        end
    end
    return false
end

-- isSilentAimActive - silent aim is only active while its bind is held
local function isSilentAimActive()
    if not getFlag("SilentAim", false) then return false end
    local kc = getFlag("SilentAimKey")
    if typeof(kc) == "EnumItem" then
        if isGamepadButtonEnum(kc) then
            return isGamepadButtonDown(kc)
        end
        return UserInputService:IsKeyDown(kc)
    end
    return true
end

