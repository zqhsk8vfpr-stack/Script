local FOOD_NAMES = {"Burger", "Pizza", "Chicken", "Popcorn", "Donut", "Taco", "Super Pizza", "Sauce"}
local STOMP_FOODS = {"Super Pizza", "Sauce"}

local function stripBrackets(name) return name:gsub("^%[(.*)%]$", "%1") end

local function findFood()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char then return nil end
    local function scan(container)
        if not container then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") then
                local raw = stripBrackets(child.Name)
                for _, food in ipairs(FOOD_NAMES) do
                    if raw:lower() == food:lower() then return child end
                end
            end
        end
        return nil
    end
    local found = scan(backpack)
    if found then return found end
    found = scan(char)
    if found then return found end
    return nil
end

