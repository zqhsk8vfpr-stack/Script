local function getClosestBodyPart(char)
    if not char then return nil end
    local parts = getBodyParts(char)
    if #parts == 0 then return nil end
    local crosshair = Camera.ViewportSize * 0.5
    local mode    = getFlag("target_outline_mode", "Regular")
    local scale   = tonumber(getFlag("target_outline_scale", 4.5)) or 4.5
    local maxDist = tonumber(getFlag("target_outline_max_dist")) or math.huge
    local best, bestScore = nil, math.huge
    for _, part in ipairs(parts) do
        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if on then
            local dx, dy = sp.X - crosshair.X, sp.Y - crosshair.Y
            local d = math.sqrt(dx * dx + dy * dy)
            if d <= maxDist then
                local score = d
                if mode == "Scaled" then
                    score = d / math.max(scale, 0.01)
                end
                if score < bestScore then
                    bestScore = score
                    best = part
                end
            end
        end
    end
    return best or parts[1]
end

