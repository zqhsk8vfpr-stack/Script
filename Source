local function getSilentAimPart(char)
    if not char then return nil end
    local method = getFlag("SilentAimMethod", "Direct")
    if method == "Direct" then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            local selectedName = getFlag("HitpartSelection", "Head")
            local targetEnum = HITPART_MAP[selectedName]
            if targetEnum then
                local ok, part = pcall(function() return hum:GetBodyPartR15(targetEnum) end)
                if ok and part then return part end
            end
        end
        return char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    end
    local allParts = getBodyParts(char)
    if #allParts == 0 then return char:FindFirstChild("HumanoidRootPart") end
    local crosshair = Camera.ViewportSize * 0.5
    if method == "Closest Part" then
        local best, bestDist = nil, math.huge
        for _, part in ipairs(allParts) do
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on then
                local dx, dy = sp.X - crosshair.X, sp.Y - crosshair.Y
                local dist = dx * dx + dy * dy
                if dist < bestDist then bestDist = dist; best = part end
            end
        end
        if not best then best = allParts[1] end
        if getFlag("SilentAimWallCheck", false) and not isVisible(best.Position, char) then
            local vis = findVisiblePart(char, allParts)
            if vis then return vis end
        end
        return best
    end
    if method == "Nearest Point" then
        local ray = Camera:ViewportPointToRay(crosshair.X, crosshair.Y)
        _silentRayParams.FilterDescendantsInstances = allParts
        local result = Workspace:Raycast(ray.Origin, ray.Direction * 10000, _silentRayParams)
        if result and (not getFlag("SilentAimWallCheck", false) or isVisible(result.Position, char)) then
            return result.Instance
        end
        local best, bestDist = nil, math.huge
        for _, part in ipairs(allParts) do
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on then
                local dx, dy = sp.X - crosshair.X, sp.Y - crosshair.Y
                local dist = dx * dx + dy * dy
                if dist < bestDist then bestDist = dist; best = part end
            end
        end
        if not best then best = allParts[1] end
        if getFlag("SilentAimWallCheck", false) and not isVisible(best.Position, char) then
            local vis = findVisiblePart(char, allParts)
            if vis then return vis end
        end
        return best
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function detectAntiAim(part)
    if not part then return false end
    local hum = part.Parent and part.Parent:FindFirstChildWhichIsA("Humanoid")
    if not hum then return false end
    local vel = part.AssemblyLinearVelocity
    local intent = hum.MoveDirection * hum.WalkSpeed
    local velMag = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local intentMag = intent.Magnitude
    if velMag > 3 and intentMag < 1 then return true end
    if velMag > 2 and intentMag > 2 then
        local flatVel = Vector3.new(vel.X, 0, vel.Z).Unit
        local flatIntent = intent.Unit
        if flatVel:Dot(flatIntent) < -0.3 then return true end
    end
    local root = part.Parent:FindFirstChild("HumanoidRootPart")
    if root and root.AssemblyAngularVelocity.Magnitude > 8 then return true end
    return false
end

local function getResolverVelocity(part)
    if not part then return Vector3.zero end
    local char = part.Parent
    if not char then return Vector3.zero end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local observed = hum and (hum.MoveDirection * hum.WalkSpeed) or nil
    local claimed = part.AssemblyLinearVelocity
    if not observed then return claimed end
    if _realMoving[char] == false then return Vector3.zero end
    if getFlag("Resolver", false) == true then return observed end
    local useObserved = false
    if getFlag("AutoResolver", false) == true then
        local now = tick()
        local cached = resolverState[char]
        if not cached or (now - cached.time) > 0.15 then
            local detected = detectAntiAim(part)
            resolverState[char] = { detected = detected, time = now }
            cached = resolverState[char]
        end
        if cached and cached.detected then useObserved = true end
    end
    local claimedFlat  = Vector3.new(claimed.X, 0, claimed.Z)
    local observedFlat = Vector3.new(observed.X, 0, observed.Z)
    if (claimedFlat - observedFlat).Magnitude > 15 then useObserved = true end
    local result = useObserved and observed or claimed
    local prev = _lastResolvedVel[char]
    if prev then result = prev:Lerp(result, 0.25) end
    _lastResolvedVel[char] = result
    return result
end

local function createABTracker()
    return {
        px = 0, py = 0, pz = 0,
        vx = 0, vy = 0, vz = 0,
        init = false, last = tick(),
    }
end

local function updateAdvancedTracker(char, part)
    if not char or not part then return end
    local t = _advancedTrackers[char]
    if not t then
        t = createABTracker()
        _advancedTrackers[char] = t
        t.last = tick()
    end
    local now = tick()
    local dt = now - t.last
    t.last = now
    if dt <= 0 then dt = 1 / 60 end
    if dt > 0.5 then dt = 0.5 end
    local alpha = tonumber(getFlag("ABAlpha", 0.6)) or 0.6
    local beta  = tonumber(getFlag("ABBeta", 0.15)) or 0.15
    if alpha < 0.01 then alpha = 0.01 end
    if alpha > 1 then alpha = 1 end
    if beta < 0 then beta = 0 end
    if beta > 1 then beta = 1 end
    local p = part.Position
    if not t.init then
        t.px, t.py, t.pz = p.X, p.Y, p.Z
        t.vx, t.vy, t.vz = 0, 0, 0
        t.init = true
        return
    end
    local predX = t.px + t.vx * dt
    local predY = t.py + t.vy * dt
    local predZ = t.pz + t.vz * dt
    local rx = p.X - predX
    local ry = p.Y - predY
    local rz = p.Z - predZ
    t.px = predX + alpha * rx
    t.py = predY + alpha * ry
    t.pz = predZ + alpha * rz
    t.vx = t.vx + (beta / dt) * rx
    t.vy = t.vy + (beta / dt) * ry
    t.vz = t.vz + (beta / dt) * rz
end

local function getAdvancedPredicted(char, aimPart, timeAhead)
    local t = _advancedTrackers[char]
    if not t or not t.init then return nil end
    if not aimPart or not aimPart.Parent then return nil end
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    timeAhead = timeAhead or 0.045
    local predRoot = Vector3.new(
        t.px + t.vx * timeAhead,
        t.py + t.vy * timeAhead,
        t.pz + t.vz * timeAhead
    )
    local offset = aimPart.Position - root.Position
    return predRoot + offset
end

local function getAdvancedTimeAhead(aimPos, camPos)
    if not getFlag("AdvancedAutoTime", false) then
        return tonumber(getFlag("AdvancedTimeAhead", 0.045)) or 0.045
    end
    local bulletSpeed = tonumber(getFlag("BulletSpeed", 1200)) or 1200
    local ping = (getgenv().CachedPing or 60) / 1000
    local dist = (aimPos - camPos).Magnitude
    return dist / math.max(bulletSpeed, 1) + ping * 0.5
end

