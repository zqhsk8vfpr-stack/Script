local function animateMasterVisibility(tags, on)
    tags.NameGui.Enabled = true
    tags.DistGui.Enabled = true
    tags.BoxFrame.Visible = true
    local t = on and 0 or 1
    tween(tags.NameLabel, TWEEN_INFO_FAST, { TextTransparency = t })
    tween(tags.DistLabel, TWEEN_INFO_FAST, { TextTransparency = t })
    tween(tags.BoxStroke, TWEEN_INFO_FAST, { Transparency = t })
end

local function animateNameVisibility(tags, on)
    if on then tags.NameGui.Enabled = true end
    tween(tags.NameLabel, TWEEN_INFO_FAST, { TextTransparency = on and 0 or 1 })
end

local function animateDistVisibility(tags, on)
    if on then tags.DistGui.Enabled = true end
    tween(tags.DistLabel, TWEEN_INFO_FAST, { TextTransparency = on and 0 or 1 })
end

local function animateBoxVisibility(tags, on)
    if on then tags.BoxFrame.Visible = true end
    tween(tags.BoxStroke, TWEEN_INFO_FAST, { Transparency = on and 0 or 1 })
end

local function animateColorTransition(tags, newColor)
    tween(tags.NameLabel, TWEEN_INFO_SMOOTH, { TextColor3 = newColor })
    tween(tags.DistLabel, TWEEN_INFO_SMOOTH, { TextColor3 = newColor })
    tween(tags.BoxStroke, TWEEN_INFO_SMOOTH, { Color = newColor })
end

RunService.RenderStepped:Connect(function()
    local masterOn = _espMasterOn
    local nameOn   = _espNameOn
    local distOn   = _espDistOn
    local boxOn    = _espBoxOn

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Head") then
            if not esp_tags[plr] then createESP(plr) end
            local tags = esp_tags[plr]
            if not tags then continue end

            local root = plr.Character.HumanoidRootPart
            local head = plr.Character.Head

            if tags.lastMasterOn ~= masterOn then
                tags.lastMasterOn = masterOn
                animateMasterVisibility(tags, masterOn)
            end

            if masterOn and root then
                tags.NameGui.Adornee = root
                tags.NameGui.Parent = root
                tags.DistGui.Adornee = root
                tags.DistGui.Parent = root

                if tags.lastNameOn ~= nameOn then
                    tags.lastNameOn = nameOn
                    animateNameVisibility(tags, nameOn)
                end
                if tags.lastDistOn ~= distOn then
                    tags.lastDistOn = distOn
                    animateDistVisibility(tags, distOn)
                end
                if tags.lastBoxOn ~= boxOn then
                    tags.lastBoxOn = boxOn
                    animateBoxVisibility(tags, boxOn)
                end

                if nameOn then tags.NameLabel.Text = plr.DisplayName end
                if distOn then
                    tags.DistLabel.Text = tostring(math.round((root.Position - Camera.CFrame.Position).Magnitude)) .. "m"
                end

                local currentState = playerPriority[plr.UserId] or "Neutral"
                if tags.lastColorState ~= currentState then
                    tags.lastColorState = currentState
                    animateColorTransition(tags, getTargetColor(plr.UserId))
                end

                if boxOn then
                    local headPos, onScreen1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local feetPos, onScreen2 = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.5, 0))
                    if onScreen1 and onScreen2 then
                        local height = math.abs(headPos.Y - feetPos.Y)
                        local width = height * 0.6
                        tags.BoxFrame.Size = UDim2.new(0, width, 0, height)
                        tags.BoxFrame.Position = UDim2.new(0, headPos.X - (width / 2), 0, headPos.Y)
                    else
                        tags.BoxStroke.Transparency = 1
                    end
                end
            else
                if tags.NameGui.Enabled then
                    tags.NameGui.Enabled = false
                    tags.DistGui.Enabled = false
                    tags.BoxFrame.Visible = false
                end
            end
        end
    end
end)

