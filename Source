local function applyPrediction(aimPos, aimPart, char, camPos, mode, sX, sY, sZ)
    sX = sX or 0.115
    sY = sY or 0.115
    sZ = sZ or 0.115
    if mode == "Advanced" and char and aimPart then
        local dtAhead = getAdvancedTimeAhead(aimPos, camPos)
        local aPos = getAdvancedPredicted(char, aimPart, dtAhead)
        if aPos then return aPos end
    end
    local vel = aimPart and getResolverVelocity(aimPart) or Vector3.zero
    return aimPos + Vector3.new(vel.X * sX, vel.Y * sY, vel.Z * sZ)
end

local function computeSilentAimPosition(part, usePrediction, useAutoPred, accuracy)
    if not part then return nil end
    local aimPos = part.Position
    local char = part.Parent
    if usePrediction or useAutoPred then
        local mode = getFlag("SilentAimAutoPredictionMode", "Regular")
        local hPred = getFlag("SilentAimPredX", 0.115)
        local vPred = getFlag("SilentAimPredY", 0.115)
        local zPred = getFlag("SilentAimPredZ", 0.115)
        aimPos = applyPrediction(aimPos, part, char, Camera.CFrame.Position, mode, hPred, vPred, zPred)
    end
    if accuracy and accuracy < 100 then
        local spread = (100 - accuracy) / 100 * 0.04
        local angle = math.random() * 2 * math.pi
        local randomDir = Vector3.new(math.cos(angle), math.sin(angle), 0) * spread
        aimPos = aimPos + randomDir
    end
    return aimPos
end

