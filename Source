local function tryBuy(model)
    local cd = model:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then
        if fireclickdetector then
            pcall(fireclickdetector, cd)
            return true
        else
            local p
            for _, desc in ipairs(model:GetDescendants()) do if desc:IsA("BasePart") then p = desc; break end end
            if p then
                local pos, on = Camera:WorldToScreenPoint(p.Position)
                if on then
                    vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
                    task.wait(0.05)
                    vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
                    return true
                end
            end
        end
    end
    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Enabled then
        prompt:Prompt()
        return true
    end
    return false
end

local function hasItem(name)
    local ch = LocalPlayer.Character
    local bp = LocalPlayer.Backpack
    for _, c in pairs((ch and ch:GetChildren()) or {}) do if c:IsA("Tool") and c.Name == name then return true end end
    for _, c in pairs((bp and bp:GetChildren()) or {}) do if c:IsA("Tool") and c.Name == name then return true end end
    return false
end

task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            if not getFlag("AutoBuy", true) then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local pos = hrp.Position
            if tick() - lastBuy < (tonumber(getFlag("BuyCooldown", 0)) or 0) then return end
            local prox = tonumber(getFlag("BuyProximity", 20)) or 20
            local selectedGuns = getFlag("SelectedGun", {})
            local selectedFoods = getFlag("AutoBuyFoodList", {})
            if type(selectedGuns) == "string" then selectedGuns = {selectedGuns} end
            if type(selectedFoods) == "string" then selectedFoods = {selectedFoods} end
            local bought = false
            for _, entry in ipairs(cache) do
                local shouldBuy = false
                if entry.cat == "Gun" and getFlag("AutoBuyGun", true) then
                    if #selectedGuns > 0 then
                        for _, g in ipairs(selectedGuns) do
                            if g == entry.name then shouldBuy = true; break end
                        end
                    else shouldBuy = true end
                elseif entry.cat == "Food" and getFlag("AutoBuyFood", true) then
                    if #selectedFoods > 0 then
                        for _, f in ipairs(selectedFoods) do
                            if f == entry.name then shouldBuy = true; break end
                        end
                    else shouldBuy = true end
                elseif entry.cat == "Armor" and getFlag("AutoBuyArmor", true) then
                    shouldBuy = true
                end
                if shouldBuy and not hasItem(entry.name) then
                    local d = (entry.part.Position - pos).Magnitude
                    if d < prox then
                        if tryBuy(entry.model) then bought = true end
                    end
                end
            end
            if bought then lastBuy = tick() end
        end)
    end
end)

