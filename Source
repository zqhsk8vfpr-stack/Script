local function toKeyCode(s)
    if typeof(s) == "EnumItem" then return s end
    if type(s) == "number" then return Enum.KeyCode[s] or Enum.KeyCode.E end
    return KEYCODE_LOOKUP[tostring(s):upper()] or Enum.KeyCode.E
end

