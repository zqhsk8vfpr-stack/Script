    nameLabel.Size = UDim2.fromScale(1, 1)
    nameLabel.BackgroundTransparency = 1
    nameLabel.BorderSizePixel = 0
    nameLabel.Text = plr.DisplayName
    nameLabel.TextColor3 = COLOR_NEUTRAL
    nameLabel.TextStrokeTransparency = 1
    nameLabel.TextTransparency = 1
    nameLabel.TextSize = 7
    nameLabel.Font = Enum.Font.GothamBlack
    nameLabel.Parent = nameGui

    local nameStroke = Instance.new("UIStroke")
    nameStroke.Color = Color3.fromRGB(0, 0, 0)
    nameStroke.Thickness = 1
    nameStroke.LineJoinMode = Enum.LineJoinMode.Round
    nameStroke.Parent = nameLabel

    local distGui = Instance.new("BillboardGui")
    distGui.Name = "OverheadDistanceTag"
    distGui.Size = UDim2.fromScale(2, 0.8)
    distGui.StudsOffset = Vector3.new(0, -3, 0)
    distGui.AlwaysOnTop = true
    distGui.LightInfluence = 0
    distGui.MaxDistance = 500
    distGui.Enabled = false

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "DistanceLabel"
    distLabel.Size = UDim2.fromScale(1, 1)
    distLabel.BackgroundTransparency = 1
    distLabel.BorderSizePixel = 0
    distLabel.Text = ""
    distLabel.TextColor3 = COLOR_NEUTRAL
    distLabel.TextStrokeTransparency = 1
    distLabel.TextTransparency = 1
    distLabel.TextSize = 7
    distLabel.Font = Enum.Font.GothamBlack
