local NO_RECURSE = { GunConfigs = true, ["Selected Guns"] = true, ["Selected Foods"] = true }

local function TapConfig(tbl, prefix)
    for key, value in pairs(tbl) do
        local path = prefix and (prefix .. "." .. key) or key
        if type(value) == "table" and not NO_RECURSE[key] then
            TapConfig(value, path)
        else
            local flagName = PATHS[path]
            if flagName then
                getgenv()[flagName] = value
            end
        end
    end
end

if type(Shared) == "table" and type(Shared.Astra) == "table" then
