local function onAutoBuyDescendantRemoving(inst)
    local entry = cacheByModel[inst]
    if not entry then return end
    cacheByModel[inst] = nil
    for i = #cache, 1, -1 do
        if cache[i] == entry then
            table.remove(cache, i)
            break
        end
    end
end

task.spawn(function()
    local stack = { workspace }
    local processed = 0
    while #stack > 0 do
        local inst = table.remove(stack)
        tryCacheModel(inst)
        for _, child in ipairs(inst:GetChildren()) do stack[#stack + 1] = child end
        processed = processed + 1
        if processed % 200 == 0 then task.wait(0.05) end
    end
end)

