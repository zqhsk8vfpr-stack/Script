local _cachedPriority     = "closest"
local _cachedPriorityRaw  = nil
local _cachedActivation   = "Hold"
local _lastPriorityPoll   = 0

local function aimbotStep(camCF, camPos, camLook, dt)
    if not getFlag("Enabled", true) then return end

    local now = tick()
    if now - _lastPriorityPoll > 0.2 then
        _lastPriorityPoll = now
        local rawPriority = tostring(getFlag("TargetPriority", "Closest"))
        if rawPriority ~= _cachedPriorityRaw then
            _cachedPriorityRaw = rawPriority
            local key = rawPriority:lower():gsub("[%s_%-]", "")
            _cachedPriority = TARGET_PRIORITY_MAP[key] or "closest"
        end
        _cachedActivation = getFlag("Activation", "Hold")
        _cachedSmoothX    = tonumber(getFlag("SmoothnessX", 0.25)) or 0.25
        _cachedSmoothY    = tonumber(getFlag("SmoothnessY", 0.25)) or 0.25

        local rawKey = getFlag("AimbotKey")
        local resolved = rawKey and getKeyCode(rawKey) or nil
        if resolved and (isKeyboardKeyCode(resolved) or mouseButtons[resolved] ~= nil or isGamepadButtonEnum(resolved)) then
            _cachedAimbotKeyEnum = resolved
        else
            _cachedAimbotKeyEnum = nil
        end
    end

    local activation = _cachedActivation
    if activation ~= lastActivationMode then
        aimbotToggleState = false
        lastActivationMode = activation
        clearSticky()
    end

    local shouldLock = false
    local enemiesList = nil
    local priority = _cachedPriority
    local physical = isAimbotKeyPhysicallyDown()

    if activation == "Rage" then
        shouldLock = true
        enemiesList = getValidEnemies()
        currentTarget = selectTarget(enemiesList)
        if not currentTarget then SilentTarget = nil; return end
    elseif activation == "Mobile" then
        if isTouching then
            shouldLock = true
            enemiesList = getValidEnemies()
            currentTarget = selectTarget(enemiesList)
            if not currentTarget then SilentTarget = nil; return end
        else
            currentTarget = nil; SilentTarget = nil; return
        end
    elseif activation == "Hold" then
        if physical then
            shouldLock = true
            enemiesList = getValidEnemies()
        else
            currentTarget = nil; SilentTarget = nil; return
        end
    elseif activation == "Toggle" then
        if aimbotToggleState then
            shouldLock = true
            enemiesList = getValidEnemies()
        else
            currentTarget = nil; SilentTarget = nil; return
        end
    else
        currentTarget = nil; SilentTarget = nil; return
    end

    if not shouldLock then currentTarget = nil; SilentTarget = nil; return end

    if activation ~= "Rage" and activation ~= "Mobile" then
        if stickyPlayer and not stickyPlayer.Parent then
            stickyPlayer = nil
            hasEverPicked = false
            aimbotToggleState = false
        end

        if not stickyPlayer and not hasEverPicked and priority ~= "manual" and enemiesList and #enemiesList > 0 then
            local pick = selectTarget(enemiesList)
            if pick then
                stickyPlayer = pick.player
                hasEverPicked = true
            end
        end

        currentTarget = nil
        if stickyPlayer then
            if enemiesList then
                for _, data in ipairs(enemiesList) do
                    if data.player == stickyPlayer then
                        currentTarget = data
                        break
                    end
                end
            end
            if not currentTarget then
                local spChar = stickyPlayer.Character
                local skipKnock = getFlag("AimbotKnockCheck", false) and IsKnocked(spChar)
                local skipFF = getFlag("AimbotForcefieldCheck", false) and hasForcefield(spChar)
                if not skipKnock and not skipFF then
                    currentTarget = buildTargetFromPlayer(stickyPlayer)
                end
            end
        end
    end

    if not currentTarget then SilentTarget = nil; return end
    if not currentTarget.player or not currentTarget.player.Parent then
        currentTarget = nil; SilentTarget = nil; return
    end
    if currentTarget.character ~= currentTarget.player.Character then
        local rebuilt = buildTargetFromPlayer(currentTarget.player)
        if rebuilt then currentTarget = rebuilt
        else SilentTarget = nil; return end
    end

    if isSilentAimActive() then SilentTarget = currentTarget
    else SilentTarget = nil end

    local char = currentTarget.character
    local root = currentTarget.rootPart
    if not char or not char.Parent or not root or not root.Parent then
        SilentTarget = nil; return
    end

    local aimPart = getAimPart(char)
    if not aimPart then aimPart = root end
    if not aimPart or not aimPart.Parent then SilentTarget = nil; return end
    local aimPos = aimPart.Position

    local predictionOn = getFlag("PredictionEnabled", false) or getFlag("Prediction", false) or getFlag("AutoPrediction", false)
    if predictionOn then
        local mode = getFlag("AutoPredictionMode", "Regular")
        local hPred = getFlag("PredictionX", 0.115)
        local vPred = getFlag("PredictionY", 0.115)
        local zPred = getFlag("PredictionZ", 0.115)
        aimPos = applyPrediction(aimPos, aimPart, char, camPos, mode, hPred, vPred, zPred)
    end

    if IsAirborne(char) then
        local jumpOff = tonumber(getFlag("JumpOffset", 0)) or 0
        if jumpOff ~= 0 then aimPos = aimPos + Vector3.new(0, jumpOff, 0) end
    else
        local fallOff = tonumber(getFlag("FallOffset", 0)) or 0
        if fallOff ~= 0 then aimPos = aimPos + Vector3.new(0, fallOff, 0) end
    end

    if getFlag("AimbotWallCheck", false) then
        if not isVisible(aimPos, char) then return end
    end

    local desiredCF = CFrame.lookAt(camPos, aimPos)

    local smoothX = _cachedSmoothX
    local smoothY = _cachedSmoothY
    if smoothX <= 0 then smoothX = 0.01 end
    if smoothY <= 0 then smoothY = 0.01 end
    if smoothX > 10 then smoothX = 10 end
    if smoothY > 10 then smoothY = 10 end

    local combinedSmooth = (smoothX + smoothY) / 2
    local alpha = 1 - math.exp(-combinedSmooth * dt * 60)

    if alpha >= 0.999 then
        Camera.CFrame = desiredCF
    else
        Camera.CFrame = camCF:Lerp(desiredCF, alpha)
    end
end

local lastAutoShootTime = 0

local function autoShootStep()
    if not getFlag("AutoShoot", false) then return end

    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    if not isWeapon(tool) then return end

    local rawName = tool.Name:match("%[(.-)%]") or tool.Name
    rawName = rawName:gsub("^%s+", ""):gsub("%s+$", "")
    if rawName:lower() ~= "usp" then return end

    local triggerKey = getFlag("AutoShootKey")
    if triggerKey then
        local held = false
        if isGamepadButtonEnum(triggerKey) then
            held = isGamepadButtonDown(triggerKey)
        elseif typeof(triggerKey) == "EnumItem" then
            held = UserInputService:IsKeyDown(triggerKey)
        end
        if not held then return end
    end

    local hitChance = getFlag("AutoShootHitChance", 100)
    local weaponHit = getWeaponHitChance(tool)
    if weaponHit then hitChance = weaponHit end
    if math.random(100) > hitChance then return end

    local now = tick()
    local delay = tonumber(getFlag("AutoShootDelay", 0.1)) or 0.1
    if now - lastAutoShootTime < delay then return end

    local target = currentTarget or SilentTarget
    if not target or not target.character then return end
    if target.character ~= target.player.Character then return end
    local targetChar = target.character
    if getFlag("AutoShootForcefieldCheck", false) and targetChar:FindFirstChildOfClass("ForceField") then return end
    local hum = targetChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    if getFlag("AutoAir", false) then
        if hum:GetState() ~= Enum.HumanoidStateType.Freefall then return end
    end

    local aimPart = getAimPart(targetChar)
    if not aimPart then return end
    local aimPos = aimPart.Position

    if getFlag("PredictionEnabled", false) or getFlag("Prediction", false) or getFlag("AutoPrediction", false) then
        local mode = getFlag("AutoPredictionMode", "Regular")
        local hPred = getFlag("PredictionX", 0.115)
        local vPred = getFlag("PredictionY", 0.115)
        local zPred = getFlag("PredictionZ", 0.115)
        aimPos = applyPrediction(aimPos, aimPart, targetChar, Camera.CFrame.Position, mode, hPred, vPred, zPred)
    end

    if getFlag("AimbotWallCheck", false) and not isVisible(aimPos, targetChar) then return end

    local antiCurve = tonumber(getFlag("AntiCurve", 8)) or 8
    if antiCurve > 0 then
        local camCF = Camera.CFrame
        local dir = (aimPos - camCF.Position).Unit
        local angle = math.deg(math.acos(camCF.LookVector:Dot(dir)))
        if angle > antiCurve then return end
    end

    if tool.Parent == char then
        tool:Activate()
        lastAutoShootTime = now
    end
end

